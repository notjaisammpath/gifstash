// Copy to Secrets.xcconfig (gitignored) and fill in.
//
//   cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
//
// GIPHY key: https://developers.giphy.com/dashboard/  (create an app, SDK or API)
// Tenor key: https://developers.google.com/tenor/guides/quickstart  (optional)

GIPHY_API_KEY = your_giphy_key_here
TENOR_API_KEY =

// Reverse-DNS prefix you control. Changing this changes the App Group too,
// so the app and extension stay matched automatically.
BUNDLE_ID_PREFIX = com.yourname

// Your 10-character Apple Developer team ID, needed for device builds.
DEVELOPMENT_TEAM =
